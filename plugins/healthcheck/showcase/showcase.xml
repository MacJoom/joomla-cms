<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="healthcheck" method="upgrade">
	<name>plg_healthcheck_showcase</name>
	<author>Joomla! Project</author>
	<creationDate>2026-06</creationDate>
	<copyright>(C) 2026 Open Source Matters, Inc.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>admin@joomla.org</authorEmail>
	<authorUrl>www.joomla.org</authorUrl>
	<version>6.2.0</version>
	<description>PLG_HEALTHCHECK_SHOWCASE_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\Healthcheck\Showcase</namespace>
	<files>
		<folder plugin="showcase">services</folder>
		<folder>src</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_healthcheck_showcase.ini</language>
		<language tag="en-GB">language/en-GB/plg_healthcheck_showcase.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="context"
					type="text"
					label="PLG_HEALTHCHECK_SHOWCASE_CONTEXT_LABEL"
					description="PLG_HEALTHCHECK_SHOWCASE_CONTEXT_DESC"
					default="testing"
				/>
			</fieldset>
		</fields>
	</config>
</extension>